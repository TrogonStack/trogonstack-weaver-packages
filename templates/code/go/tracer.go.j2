{% import "header.j2" as h -%}
{% import "names.j2" as n -%}
{%- filter regex_replace("(?m)`\\n(\\t?// )([.,;:!?)]+) ", "`${2}\n${1}") | regex_replace("(?m)`\\n\\t?// ([.,;:!?)]+)$", "`${1}") | regex_replace("(?m)`\\n(\\t?// ) (\\S)", "`\n${1}${2}") -%}
{{ h.header() }}

package {{ n.root() }}tracer

import (
	"go.opentelemetry.io/otel/trace"
	"go.opentelemetry.io/otel/trace/noop"

	{% if params.import_path.split("/") | last != n.root() %}{{ n.root() }} {% endif %}"{{ params.import_path }}"
)

{{ ["Tracer is a trace.Tracer whose instrumentation scope carries " ~ n.root() ~ ".SchemaURL, so every span it starts is tied to the registry's schema.", "The zero Tracer starts spans that record nothing."] | join("\n\n") | comment }}
type Tracer struct{ tracer trace.Tracer }

{{ ["New returns the tracer named name from provider, with " ~ n.root() ~ ".SchemaURL set on its instrumentation scope. A schema URL in opts is replaced."] | join | comment }}
func New(provider trace.TracerProvider, name string, opts ...trace.TracerOption) Tracer {
	opts = append(opts[:len(opts):len(opts)], trace.WithSchemaURL({{ n.root() }}.SchemaURL))
	return Tracer{tracer: provider.Tracer(name, opts...)}
}

{{ ["TraceTracer returns the underlying trace.Tracer, or a no-op one for the zero Tracer."] | join | comment }}
func (t Tracer) TraceTracer() trace.Tracer {
	if t.tracer == nil {
		return noop.Tracer{}
	}
	return t.tracer
}
{% endfilter %}
