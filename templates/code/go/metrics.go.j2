{% import "header.j2" as h -%}
{% import "deprecation.j2" as d -%}
{% import "names.j2" as n -%}
{%- macro attr_type(a) -%}
{%- if a.imported -%}
{{ a.attr_type | map_text("attribute_field_type") }}
{%- else -%}
{{ a.attr_namespace }}attr.{{ n.exported(a.attr_short_name) }}
{%- endif -%}
{%- endmacro -%}
{%- macro attr_kv(a, v) -%}
{%- if a.imported -%}
attribute.{{ a.attr_type | map_text("attribute_type_method") }}({{ a.key | tojson }}, {{ v }})
{%- else -%}
{{ v }}.KeyValue()
{%- endif -%}
{%- endmacro -%}
{%- macro attr_params(def) -%}
{%- for req in def.required %}, {{ n.unexported(req.attr_param) }} {{ attr_type(req) }}{% endfor %}{% if def.optional %}, opts ...{{ n.exported(def.short_name) }}Attr{% endif %}
{%- endmacro -%}
{#- A fixed-size array stays on the stack, where a make with a length that
    depends on len(opts) would go to the heap on every call. #}
{%- macro attr_set(def) %}
	var buffer [{{ def.attributes | length }}]attribute.KeyValue
	kvs := buffer[:0]
{%- for req in def.required %}
{%- if req.imported %}
	kvs = append(kvs, {{ attr_kv(req, n.unexported(req.attr_param)) }})
{%- else %}
	if kv := {{ n.unexported(req.attr_param) }}.KeyValue(); kv.Valid() {
		kvs = append(kvs, kv)
	}
{%- endif %}
{%- endfor %}
{%- if def.optional %}
	for _, opt := range opts {
		if kv := opt.{{ n.unexported(def.short_name) }}Attr(); kv.Valid() {
			kvs = append(kvs, kv)
		}
	}
{%- endif %}
{%- endmacro -%}
{%- filter regex_replace("(?m)`\\n(\\t?// )([.,;:!?)]+) ", "`${2}\n${1}") | regex_replace("(?m)`\\n\\t?// ([.,;:!?)]+)$", "`${1}") | regex_replace("(?m)`\\n(\\t?// ) (\\S)", "`\n${1}${2}") -%}
{{ h.header() }}

package {{ ctx.namespace }}metric

import (
	"context"
	"fmt"
{% if ctx.uses_attributes %}
	"go.opentelemetry.io/otel/attribute"
{%- endif %}
	"go.opentelemetry.io/otel/metric"
{% for imp in ctx.imports %}
	"{{ imp.path }}"
{%- endfor %}
)
{% for def in ctx.metrics %}
{%- set suffix = def.instrument | map_text("metric_instrument") %}
{%- set name = n.exported(def.short_name) %}
{%- set private = n.unexported(def.short_name) %}
{%- set method = def.instrument | map_text("metric_instrument_method") %}
{%- set arg = def.instrument | map_text("metric_instrument_arg") %}
{%- set value_type = def.annotations.code_generation.metric_value_type | map_text("metric_value_type") %}
{%- set gotype = value_type | lower %}
{%- set instrument = value_type ~ suffix %}
{%- set deprecated = d.notice(def) %}
{%- set has_attributes = def.required or def.optional %}
{%- set set_type = name ~ "Set" %}
{%- set sync_field = method | lower %}
{%- set field_padding = " " * (7 - (sync_field | length)) if def.instrument != "histogram" else "" %}
{%- set opt_in = "Opt-in: the convention records `" ~ def.name ~ "` only when a user asks for it." if def.requirement_level == "opt_in" else none -%}
{% if def.optional %}
{{ [name ~ "Attr is an attribute `" ~ def.name ~ "` accepts in addition to the ones " ~ name ~ "." ~ method ~ " requires."] | join | comment }}
type {{ name }}Attr interface {
	{{ private }}Attr() attribute.KeyValue
}
{% for opt in def.optional %}
{%- set optname = n.exported(opt.attr_short_name) %}
type {{ private }}{{ optname }} struct{ v {{ attr_type(opt) }} }

func (o {{ private }}{{ optname }}) {{ private }}Attr() attribute.KeyValue {
	return {{ attr_kv(opt, "o.v") }}
}

{{ ["With" ~ name ~ optname ~ " attaches `" ~ opt.key ~ "` to " ~ name ~ ".", opt.requirement_doc] | select | join("\n\n") | comment }}
func With{{ name }}{{ optname }}(v {{ attr_type(opt) }}) {{ name }}Attr {
	return {{ private }}{{ optname }}{v: v}
}
{% endfor %}
{%- endif %}
{%- if has_attributes %}
{{ [set_type ~ " is the attribute set of a `" ~ def.name ~ "` measurement, built once with New" ~ set_type ~ " so that " ~ name ~ "." ~ method ~ "Set does not build it on every call. The zero " ~ set_type ~ " holds no attributes."] | join | comment }}
type {{ set_type }} struct {
	{{ sync_field }}{{ field_padding }} []metric.{{ method }}Option
{%- if def.instrument != "histogram" %}
	observe []metric.ObserveOption
{%- endif %}
}

{{ ["New" ~ set_type ~ " builds the attribute set of a `" ~ def.name ~ "` measurement from the attributes " ~ name ~ "." ~ method ~ " takes."] | join | comment }}
func New{{ set_type }}({{ attr_params(def) | trim(", ") }}) {{ set_type }} {
{{- attr_set(def) }}
	attributes := metric.WithAttributeSet(attribute.NewSet(kvs...))
	return {{ set_type }}{
		{{ sync_field }}:{{ field_padding }} []metric.{{ method }}Option{attributes},
{%- if def.instrument != "histogram" %}
		observe: []metric.ObserveOption{attributes},
{%- endif %}
	}
}
{% endif %}
{{ [name ~ " is `" ~ def.name ~ "`" ~ (", a refinement of `" ~ def.refines ~ "` that records under that metric's name" if def.refines else "") ~ ".", def.brief, def.note, opt_in, deprecated] | select | join("\n\n") | comment }}
type {{ name }} struct{ inst metric.{{ instrument }} }

{{ ["New" ~ name ~ " creates the `" ~ def.instrument_name ~ "` instrument from meter.", opt_in, deprecated] | select | join("\n\n") | comment }}
func New{{ name }}(meter {{ n.root() }}meter.Meter) ({{ name }}, error) {
	var m {{ name }}
	inst, err := scope.MetricMeter(meter).{{ instrument }}(
		m.Name(),
		metric.WithDescription({{ (def.description or "") | trim | tojson }}),
		metric.WithUnit({{ (def.unit or "") | tojson }}),
{%- if def.bucket_boundaries %}
		metric.WithExplicitBucketBoundaries({{ def.bucket_boundaries | join(", ") }}),
{%- endif %}
	)
	if err != nil {
		return {{ name }}{}, fmt.Errorf("create the %s instrument: %w", m.Name(), err)
	}
	return {{ name }}{inst: inst}, nil
}

{{ ["Name returns the name `" ~ def.name ~ "` records under."] | join | comment }}
func ({{ name }}) Name() string {
	return {{ def.instrument_name | tojson }}
}

{{ [method ~ " records one `" ~ def.name ~ "` measurement. The zero " ~ name ~ " records nothing, and neither does one whose instrument is disabled."] | join | comment }}
func (m {{ name }}) {{ method }}(ctx context.Context, {{ arg }} {{ gotype }}{{ attr_params(def) }}) {
	if m.inst == nil || !m.inst.Enabled(ctx) {
		return
	}
{%- if has_attributes %}
{{- attr_set(def) }}
	m.inst.{{ method }}(ctx, {{ arg }}, metric.WithAttributeSet(attribute.NewSet(kvs...)))
{%- else %}
	m.inst.{{ method }}(ctx, {{ arg }})
{%- endif %}
}
{%- if has_attributes %}

{{ [method ~ "Set records one `" ~ def.name ~ "` measurement with the attributes in set. The zero " ~ name ~ " records nothing, and neither does one whose instrument is disabled."] | join | comment }}
func (m {{ name }}) {{ method }}Set(ctx context.Context, {{ arg }} {{ gotype }}, set {{ set_type }}) {
	if m.inst == nil || !m.inst.Enabled(ctx) {
		return
	}
	m.inst.{{ method }}(ctx, {{ arg }}, set.{{ sync_field }}...)
}
{%- endif %}
{%- if def.instrument != "histogram" %}
{%- set observable = name ~ "Observable" %}
{%- set observer = name ~ "Observer" %}
{%- set callback = name ~ "Callback" %}

{{ [observer ~ " records `" ~ def.name ~ "` observations from the callback of a " ~ observable ~ ". The zero " ~ observer ~ " records nothing."] | join | comment }}
type {{ observer }} struct {
	o metric.{{ value_type }}Observer
}

{{ ["Observe records one `" ~ def.name ~ "` observation."] | join | comment }}
func (o {{ observer }}) Observe(value {{ gotype }}{{ attr_params(def) }}) {
	if o.o == nil {
		return
	}
{%- if has_attributes %}
{{- attr_set(def) }}
	o.o.Observe(value, metric.WithAttributeSet(attribute.NewSet(kvs...)))
{%- else %}
	o.o.Observe(value)
{%- endif %}
}
{%- if has_attributes %}

{{ ["ObserveSet records one `" ~ def.name ~ "` observation with the attributes in set."] | join | comment }}
func (o {{ observer }}) ObserveSet(value {{ gotype }}, set {{ set_type }}) {
	if o.o == nil {
		return
	}
	o.o.Observe(value, set.observe...)
}
{%- endif %}

{{ [callback ~ " observes `" ~ def.name ~ "` through o on every collection of a " ~ observable ~ ".", "An error it returns is returned by the collection that ran it, and the observations made before it returned are still recorded.", deprecated] | select | join("\n\n") | comment }}
type {{ callback }} func(ctx context.Context, o {{ observer }}) error

{{ [observable ~ " is the asynchronous form of " ~ name ~ ", observed through the callback it was created with.", opt_in, deprecated] | select | join("\n\n") | comment }}
type {{ observable }} struct {
	inst metric.{{ value_type }}Observable{{ suffix }}
}

{{ ["New" ~ observable ~ " creates the `" ~ def.instrument_name ~ "` instrument from meter and registers callback to observe it on every collection.", opt_in, deprecated] | select | join("\n\n") | comment }}
func New{{ observable }}(meter {{ n.root() }}meter.Meter, callback {{ callback }}) ({{ observable }}, error) {
	var m {{ observable }}
	if callback == nil {
		return {{ observable }}{}, fmt.Errorf("create the %s instrument: the callback is nil", m.Name())
	}
	inst, err := scope.MetricMeter(meter).{{ value_type }}Observable{{ suffix }}(
		m.Name(),
		metric.WithDescription({{ (def.description or "") | trim | tojson }}),
		metric.WithUnit({{ (def.unit or "") | tojson }}),
		metric.With{{ value_type }}Callback(func(ctx context.Context, o metric.{{ value_type }}Observer) error {
			return callback(ctx, {{ observer }}{o: o})
		}),
	)
	if err != nil {
		return {{ observable }}{}, fmt.Errorf("create the %s instrument: %w", m.Name(), err)
	}
	return {{ observable }}{inst: inst}, nil
}

{{ ["Name returns the name `" ~ def.name ~ "` records under."] | join | comment }}
func ({{ observable }}) Name() string {
	return {{ name }}{}.Name()
}
{%- endif %}
{% endfor %}{% endfilter %}
