{% if ctx.uses_name_templates %}
type spanNamePart struct {
	text string
	key  attribute.Key
	enum bool
}

func spanName(kvs []attribute.KeyValue, fallback string, templates ...[]spanNamePart) string {
	for _, template := range templates {
		if length, ok := spanNameLength(kvs, template); ok {
			return spanNameBuild(kvs, template, length)
		}
	}
	return fallback
}

func spanNameValue(kvs []attribute.KeyValue, key attribute.Key) (attribute.Value, bool) {
	for index := len(kvs) - 1; index >= 0; index-- {
		if kvs[index].Key == key {
			return kvs[index].Value, true
		}
	}
	return attribute.Value{}, false
}

// The length is an upper bound, so the builder never grows and the name is its only allocation.
func spanNameLength(kvs []attribute.KeyValue, template []spanNamePart) (int, bool) {
	length := 0
	for _, part := range template {
		if part.key == "" {
			length += len(part.text)
			continue
		}
		value, found := spanNameValue(kvs, part.key)
		if !found {
			return 0, false
		}
		switch value.Type() {
{%- if "string" in types %}
		case attribute.STRING:
			text := value.AsString()
			if text == "" || (part.enum && text == "_OTHER") {
				return 0, false
			}
			length += len(text)
{%- endif %}
{%- if "boolean" in types %}
		case attribute.BOOL:
			length += len("false")
{%- endif %}
{%- if "int" in types %}
		case attribute.INT64:
			length += len("-9223372036854775808")
{%- endif %}
{%- if "double" in types %}
		case attribute.FLOAT64:
			length += len("-1.7976931348623157e+308")
{%- endif %}
{%- if "boolean[]" in types %}
		case attribute.BOOLSLICE:
			elements := value.AsBoolSlice()
			if len(elements) == 0 {
				return 0, false
			}
			length += len("[]") + len("false ")*len(elements)
{%- endif %}
{%- if "int[]" in types %}
		case attribute.INT64SLICE:
			elements := value.AsInt64Slice()
			if len(elements) == 0 {
				return 0, false
			}
			length += len("[]") + len("-9223372036854775808,")*len(elements)
{%- endif %}
{%- if "double[]" in types %}
		case attribute.FLOAT64SLICE:
			elements := value.AsFloat64Slice()
			if len(elements) == 0 {
				return 0, false
			}
			length += len("invalid: []") + len("-0.0000012345678901234567,")*len(elements)
{%- endif %}
{%- if "string[]" in types %}
		case attribute.STRINGSLICE:
			elements := value.AsStringSlice()
			if len(elements) == 0 {
				return 0, false
			}
			length += len("[]")
			for _, element := range elements {
				// encoding/json escapes one byte to at most six, as in \u001f.
				length += len(`"",`) + 6*len(element)
			}
{%- endif %}
		}
	}
	return length, true
}

// Values are written as attribute.Value.Emit writes them, so names keep the text they had.
func spanNameBuild(kvs []attribute.KeyValue, template []spanNamePart, length int) string {
	var name strings.Builder
	name.Grow(length)
{%- if types | select("in", ["int", "double", "int[]"]) | list | length > 0 %}
	var number [32]byte
{%- endif %}
	for _, part := range template {
		if part.key == "" {
			name.WriteString(part.text)
			continue
		}
		value, _ := spanNameValue(kvs, part.key)
		switch value.Type() {
{%- if "string" in types %}
		case attribute.STRING:
			name.WriteString(value.AsString())
{%- endif %}
{%- if "boolean" in types %}
		case attribute.BOOL:
			name.WriteString(strconv.FormatBool(value.AsBool()))
{%- endif %}
{%- if "int" in types %}
		case attribute.INT64:
			name.Write(strconv.AppendInt(number[:0], value.AsInt64(), 10))
{%- endif %}
{%- if "double" in types %}
		case attribute.FLOAT64:
			name.Write(strconv.AppendFloat(number[:0], value.AsFloat64(), 'g', -1, 64))
{%- endif %}
{%- if "boolean[]" in types %}
		case attribute.BOOLSLICE:
			name.WriteByte('[')
			for index, element := range value.AsBoolSlice() {
				if index > 0 {
					name.WriteByte(' ')
				}
				name.WriteString(strconv.FormatBool(element))
			}
			name.WriteByte(']')
{%- endif %}
{%- if "int[]" in types %}
		case attribute.INT64SLICE:
			name.WriteByte('[')
			for index, element := range value.AsInt64Slice() {
				if index > 0 {
					name.WriteByte(',')
				}
				name.Write(strconv.AppendInt(number[:0], element, 10))
			}
			name.WriteByte(']')
{%- endif %}
{%- if "double[]" in types %}
		case attribute.FLOAT64SLICE:
			spanNameWriteFloats(&name, value.AsFloat64Slice())
{%- endif %}
{%- if "string[]" in types %}
		case attribute.STRINGSLICE:
			name.WriteByte('[')
			for index, element := range value.AsStringSlice() {
				if index > 0 {
					name.WriteByte(',')
				}
				spanNameWriteQuoted(&name, element)
			}
			name.WriteByte(']')
{%- endif %}
		}
	}
	return name.String()
}
{%- if "double[]" in types %}

// Emit writes a float array as JSON, and falls back to fmt formatting when JSON cannot hold NaN or an infinity.
func spanNameWriteFloats(name *strings.Builder, elements []float64) {
	var number [32]byte
	for _, element := range elements {
		if math.IsInf(element, 0) || math.IsNaN(element) {
			name.WriteString("invalid: [")
			for index, element := range elements {
				if index > 0 {
					name.WriteByte(' ')
				}
				name.Write(strconv.AppendFloat(number[:0], element, 'g', -1, 64))
			}
			name.WriteByte(']')
			return
		}
	}
	name.WriteByte('[')
	for index, element := range elements {
		if index > 0 {
			name.WriteByte(',')
		}
		format := byte('f')
		if magnitude := math.Abs(element); magnitude != 0 && (magnitude < 1e-6 || magnitude >= 1e21) {
			format = 'e'
		}
		text := strconv.AppendFloat(number[:0], element, format, -1, 64)
		// encoding/json drops the leading zero of a negative exponent, as in 1e-07 to 1e-7.
		if length := len(text); format == 'e' && text[length-4] == 'e' && text[length-3] == '-' && text[length-2] == '0' {
			text[length-2] = text[length-1]
			text = text[:length-1]
		}
		name.Write(text)
	}
	name.WriteByte(']')
}
{%- endif %}
{%- if "string[]" in types %}

// Emit writes a string array as JSON, which escapes HTML characters and replaces invalid UTF-8.
func spanNameWriteQuoted(name *strings.Builder, text string) {
	const hexadecimal = "0123456789abcdef"
	name.WriteByte('"')
	start := 0
	for index := 0; index < len(text); {
		if character := text[index]; character < utf8.RuneSelf {
			if character >= ' ' && character != '"' && character != '\\' && character != '<' && character != '>' && character != '&' {
				index++
				continue
			}
			name.WriteString(text[start:index])
			switch character {
			case '"', '\\':
				name.WriteByte('\\')
				name.WriteByte(character)
			case '\b':
				name.WriteString(`\b`)
			case '\f':
				name.WriteString(`\f`)
			case '\n':
				name.WriteString(`\n`)
			case '\r':
				name.WriteString(`\r`)
			case '\t':
				name.WriteString(`\t`)
			default:
				name.WriteString(`\u00`)
				name.WriteByte(hexadecimal[character>>4])
				name.WriteByte(hexadecimal[character&0xf])
			}
			index++
			start = index
			continue
		}
		symbol, size := utf8.DecodeRuneInString(text[index:])
		switch {
		case symbol == utf8.RuneError && size == 1:
			name.WriteString(text[start:index])
			name.WriteString(`�`)
		case symbol == ' ' || symbol == ' ':
			name.WriteString(text[start:index])
			name.WriteString(`\u202`)
			name.WriteByte(hexadecimal[symbol&0xf])
		default:
			index += size
			continue
		}
		index += size
		start = index
	}
	name.WriteString(text[start:])
	name.WriteByte('"')
}
{%- endif %}
{% endif %}
{%- for def in ctx.spans %}
{%- set name = n.exported(def.short_name) %}
{%- set private = n.unexported(def.short_name) if def.short_name else "bare" %}
{%- set span = name or "Span" %}
{%- set start = "Start" ~ name %}
{%- set start_doc = "a " ~ span ~ " starter" if def.starters[0].id else start %}
{%- set deprecated = d.notice(def) %}
{%- set opt_in = "Opt-in: the convention records `" ~ def.id ~ "` only when a user asks for it." if def.requirement_level == "opt_in" else none -%}
{% if def.optional %}
{{ [name ~ "StartAttr is an attribute " ~ start_doc ~ " accepts in addition to the ones it requires."] | join | comment }}
type {{ name }}StartAttr interface {
	{{ private }}StartAttr() attribute.KeyValue
}
{% if def.has_late_attrs %}
{{ [name ~ "Attr is an attribute a " ~ span ~ " also accepts after it started, through SetAttributes."] | join | comment }}
type {{ name }}Attr interface {
	{{ name }}StartAttr
	{{ private }}Attr()
}
{% endif %}
{%- for opt in def.optional %}
{%- set optname = n.exported(opt.attr_short_name) %}
type {{ private }}Span{{ optname }} struct{ v {{ attr_type(opt) }} }

func (o {{ private }}Span{{ optname }}) {{ private }}StartAttr() attribute.KeyValue {
	return {{ attr_kv(opt, "o.v") }}
}
{% if opt.sampling_relevant %}
{{ ["With" ~ name ~ optname ~ " sets `" ~ opt.key ~ "` when " ~ start_doc ~ " starts the span. Samplers read it, so it is accepted only at start.", opt.requirement_doc] | select | join("\n\n") | comment }}
func With{{ name }}{{ optname }}(v {{ attr_type(opt) }}) {{ name }}StartAttr {
	return {{ private }}Span{{ optname }}{v: v}
}
{% else %}
func ({{ private }}Span{{ optname }}) {{ private }}Attr() {}

{{ ["With" ~ name ~ optname ~ " sets `" ~ opt.key ~ "` on a " ~ span ~ ", when " ~ start_doc ~ " starts it or later through SetAttributes.", opt.requirement_doc] | select | join("\n\n") | comment }}
func With{{ name }}{{ optname }}(v {{ attr_type(opt) }}) {{ name }}Attr {
	return {{ private }}Span{{ optname }}{v: v}
}
{% endif %}
{%- endfor %}
{%- endif %}
{%- if not def.name_derived %}
{{ [name ~ "Name is the name the `" ~ def.id ~ "` span is started with.", def.name.note, "An empty " ~ name ~ "Name, including the zero one, names the span `" ~ def.type ~ "`."] | select | join("\n\n") | comment }}
type {{ name }}Name struct{ value string }

{{ ["New" ~ name ~ "Name returns name as a " ~ name ~ "Name."] | join | comment }}
func New{{ name }}Name(name string) {{ name }}Name {
	return {{ name }}Name{value: name}
}
{% endif %}
{{ [span ~ " is a started span of `" ~ def.id ~ "`. The zero " ~ span ~ " records nothing.", deprecated] | select | join("\n\n") | comment }}
type {{ span }} struct{ span trace.Span }

func (s {{ span }}) raw() trace.Span {
	if s.span == nil {
		return noop.Span{}
	}
	return s.span
}

{{ ["End ends the span."] | join | comment }}
func (s {{ span }}) End(opts ...trace.SpanEndOption) {
	s.raw().End(opts...)
}

{{ ["SpanContext returns the span context of the span."] | join | comment }}
func (s {{ span }}) SpanContext() trace.SpanContext {
	return s.raw().SpanContext()
}

{{ ["IsRecording reports whether the span records events."] | join | comment }}
func (s {{ span }}) IsRecording() bool {
	return s.raw().IsRecording()
}
{% if def.has_late_attrs %}
func ({{ span }}) lateAttrs(attrs []{{ name }}Attr) []attribute.KeyValue {
	kvs := make([]attribute.KeyValue, 0, len(attrs))
	for _, attr := range attrs {
		if kv := attr.{{ private }}StartAttr(); kv.Valid() {
			kvs = append(kvs, kv)
		}
	}
	return kvs
}

{{ ["SetAttributes sets attributes on the span after it started."] | join | comment }}
func (s {{ span }}) SetAttributes(attrs ...{{ name }}Attr) {
	s.raw().SetAttributes(s.lateAttrs(attrs)...)
}

{{ ["AddEvent adds an event called name to the span, with attrs."] | join | comment }}
func (s {{ span }}) AddEvent(name string, attrs ...{{ name }}Attr) {
	s.raw().AddEvent(name, trace.WithAttributes(s.lateAttrs(attrs)...))
}

{{ ["AddLink links the span to sc, with attrs."] | join | comment }}
func (s {{ span }}) AddLink(sc trace.SpanContext, attrs ...{{ name }}Attr) {
	s.raw().AddLink(trace.Link{SpanContext: sc, Attributes: s.lateAttrs(attrs)})
}

{{ ["RecordError records err as an exception event on the span, with attrs."] | join | comment }}
func (s {{ span }}) RecordError(err error, attrs ...{{ name }}Attr) {
	s.raw().RecordError(err, trace.WithAttributes(s.lateAttrs(attrs)...))
}
{% else %}
{{ ["AddEvent adds an event called name to the span."] | join | comment }}
func (s {{ span }}) AddEvent(name string) {
	s.raw().AddEvent(name)
}

{{ ["AddLink links the span to sc."] | join | comment }}
func (s {{ span }}) AddLink(sc trace.SpanContext) {
	s.raw().AddLink(trace.Link{SpanContext: sc})
}

{{ ["RecordError records err as an exception event on the span."] | join | comment }}
func (s {{ span }}) RecordError(err error) {
	s.raw().RecordError(err)
}
{% endif %}
{%- if not def.name_derived %}
{{ ["SetName sets the name of the span. An empty " ~ name ~ "Name, including the zero one, names the span `" ~ def.type ~ "`."] | join | comment }}
func (s {{ span }}) SetName(name {{ name }}Name) {
	if name.value == "" {
		name = {{ name }}Name{value: {{ def.type | tojson }}}
	}
	s.raw().SetName(name.value)
}
{% endif %}
{{ ["SetStatus sets the status of the span."] | join | comment }}
func (s {{ span }}) SetStatus(code codes.Code, description string) {
	s.raw().SetStatus(code, description)
}
{% for starter in def.starters %}
{%- set starter_name = start ~ (n.exported(starter.id) if starter.id else "") %}
{{ [starter_name ~ " starts the `" ~ def.id ~ "` span from tracer with span kind " ~ def.kind ~ (", as a refinement of `" ~ def.refines ~ "`" if def.refines else "") ~ ".", def.brief, def.note, starter.name_doc, opt_in, deprecated] | select | join("\n\n") | comment }}
func {{ starter_name }}(ctx context.Context, tracer {{ n.root() }}tracer.Tracer{% if not def.name_derived %}, name {{ name }}Name{% endif %}{% for req in starter.required %}, {{ n.unexported(req.attr_param) }} {{ attr_type(req) }}{% endfor %}{% if starter.optional %}, opts ...{{ name }}StartAttr{% endif %}) (context.Context, {{ span }}) {
{%- if not def.name_derived %}
	if name.value == "" {
		name = {{ name }}Name{value: {{ def.type | tojson }}}
	}
{%- endif %}
{%- if starter.required or starter.optional %}
	kvs := make([]attribute.KeyValue, 0, {{ starter.required | length }}{% if starter.optional %}+len(opts){% endif %})
{%- for req in starter.required %}
{%- if req.imported %}
	kvs = append(kvs, {{ attr_kv(req, n.unexported(req.attr_param)) }})
{%- else %}
	if kv := {{ n.unexported(req.attr_param) }}.KeyValue(); kv.Valid() {
		kvs = append(kvs, kv)
	}
{%- endif %}
{%- endfor %}
{%- if starter.optional %}
	for _, opt := range opts {
		if kv := opt.{{ private }}StartAttr(); kv.Valid() {
			kvs = append(kvs, kv)
		}
	}
{%- endif %}
{%- endif %}
{%- if starter.name_templates %}
	name := spanName(kvs, {{ starter.name_fallback | tojson }}{% for template in starter.name_templates %},
		[]spanNamePart{ {%- for part in template.parts %}{% if not loop.first %}, {% endif %}{% if part.key %}{key: {{ part.key | tojson }}{% if part.enum %}, enum: true{% endif %}}{% else %}{text: {{ part.text | tojson }}}{% endif %}{% endfor %}}{% endfor %},
	)
{%- endif %}
	ctx, span := scope.TraceTracer(tracer).Start(
		ctx,
{%- if starter.name_templates %}
		name,
{%- elif def.name_derived %}
		{{ starter.name_fallback | tojson }},
{%- else %}
		name.value,
{%- endif %}
		trace.WithSpanKind(trace.{{ def.kind | map_text("span_kind") }}),
{%- if starter.required or starter.optional %}
		trace.WithAttributes(kvs...),
{%- endif %}
	)
	return ctx, {{ span }}{span: span}
}
{% endfor %}
{%- endfor %}{% endfilter %}
