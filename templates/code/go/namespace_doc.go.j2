{% import "header.j2" as h -%}
{% import "names.j2" as n -%}
{%- filter regex_replace("(?m)`\\n(\\t?// )([.,;:!?)]+) ", "`${2}\n${1}") | regex_replace("(?m)`\\n\\t?// ([.,;:!?)]+)$", "`${1}") | regex_replace("(?m)`\\n(\\t?// ) (\\S)", "`\n${1}${2}") -%}
{{ h.header() }}

{% if ctx.suffix == "attr" -%}
{{ ["Package " ~ ctx.namespace ~ "attr is the Go form of the attributes named " ~ ctx.patterns ~ ".",
    "Each attribute is a value type bound to its attribute.Key, so an attribute.KeyValue only exists once a value has gone through the type's constructor. Identifiers omit the namespace prefix " ~ ctx.prefix_note ~ ", because the package name already carries it."] | join("\n\n") | comment }}
package {{ ctx.namespace }}attr
{%- elif ctx.suffix == "span" -%}
{{ ["Package " ~ ctx.namespace ~ "span is the Go form of the spans named " ~ ctx.patterns ~ ".",
    "Each span and span refinement has a Start function that starts it from a " ~ n.root() ~ "tracer.Tracer with the kind the convention gives it, and returns a typed span. Required attributes are typed parameters and the rest are trailing options. Attributes passed to Start are set as the span starts, so a sampler sees them, and the options a sampler does not need can also be set later through the span's SetAttributes. A span whose name the convention spells as a template of its required attributes is named from them; any other span takes a typed name. Identifiers omit the namespace prefix " ~ ctx.prefix_note ~ ", because the package name already carries it."] | join("\n\n") | comment }}
package {{ ctx.namespace }}span
{%- elif ctx.suffix == "event" -%}
{{ ["Package " ~ ctx.namespace ~ "event is the Go form of the events named " ~ ctx.patterns ~ ".",
    "Each event and event refinement has an Emit function that emits it as a log record through a " ~ n.root() ~ "logger.Logger, under the event's name and with no body. Required attributes are typed parameters, and the rest, the severity, and the timestamp are trailing options. A record the logger is not enabled for is never emitted. Identifiers omit the namespace prefix " ~ ctx.prefix_note ~ ", because the package name already carries it."] | join("\n\n") | comment }}
package {{ ctx.namespace }}event
{%- else -%}
{{ ["Package " ~ ctx.namespace ~ "metric is the Go form of the metrics named " ~ ctx.patterns ~ ".",
    "Each metric and metric refinement is an instrument type built from a " ~ n.root() ~ "meter.Meter by its New constructor, and recorded through the method its instrument kind gives it. Counters, up-down counters, and gauges also have an Observable form, observed from a callback. Required attributes are typed parameters and the rest are trailing options. Identifiers omit the namespace prefix " ~ ctx.prefix_note ~ ", because the package name already carries it."] | join("\n\n") | comment }}
package {{ ctx.namespace }}metric
{%- endif %}
{% endfilter %}
