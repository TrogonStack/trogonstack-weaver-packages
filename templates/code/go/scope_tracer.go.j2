{% import "header.j2" as h -%}
{% import "names.j2" as n -%}
{%- filter regex_replace("(?m)`\\n(\\t?// )([.,;:!?)]+) ", "`${2}\n${1}") | regex_replace("(?m)`\\n\\t?// ([.,;:!?)]+)$", "`${1}") | regex_replace("(?m)`\\n(\\t?// ) (\\S)", "`\n${1}${2}") -%}
{{ h.header() }}

package scope

import (
	"go.opentelemetry.io/otel/trace"
	"go.opentelemetry.io/otel/trace/noop"
)

{{ ["Tracer is a trace.Tracer whose instrumentation scope carries the registry's schema URL, so every span it starts is tied to the registry's schema.", "The zero Tracer starts spans that record nothing."] | join("\n\n") | comment }}
type Tracer struct{ tracer trace.Tracer }

{{ ["NewTracer returns a Tracer that starts spans from t."] | join | comment }}
func NewTracer(t trace.Tracer) Tracer {
	return Tracer{tracer: t}
}

{{ ["TraceTracer returns the trace.Tracer inside t, or a no-op one for the zero Tracer."] | join | comment }}
func TraceTracer(t Tracer) trace.Tracer {
	if t.tracer == nil {
		return noop.Tracer{}
	}
	return t.tracer
}
{% endfilter %}
