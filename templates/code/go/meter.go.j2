{% import "header.j2" as h -%}
{% import "names.j2" as n -%}
{%- filter regex_replace("(?m)`\\n(\\t?// )([.,;:!?)]+) ", "`${2}\n${1}") | regex_replace("(?m)`\\n\\t?// ([.,;:!?)]+)$", "`${1}") | regex_replace("(?m)`\\n(\\t?// ) (\\S)", "`\n${1}${2}") -%}
{{ h.header() }}

package {{ n.root() }}meter

import (
	"go.opentelemetry.io/otel/metric"
	"go.opentelemetry.io/otel/metric/noop"

	{% if params.import_path.split("/") | last != n.root() %}{{ n.root() }} {% endif %}"{{ params.import_path }}"
)

{{ ["Meter is a metric.Meter whose instrumentation scope carries " ~ n.root() ~ ".SchemaURL. Every instrument in this registry is created from one, so everything it records is tied to the registry's schema.", "The zero Meter creates instruments that record nothing."] | join("\n\n") | comment }}
type Meter struct{ meter metric.Meter }

{{ ["New returns the meter named name from provider, with " ~ n.root() ~ ".SchemaURL set on its instrumentation scope. A schema URL in opts is replaced."] | join | comment }}
func New(provider metric.MeterProvider, name string, opts ...metric.MeterOption) Meter {
	opts = append(opts[:len(opts):len(opts)], metric.WithSchemaURL({{ n.root() }}.SchemaURL))
	return Meter{meter: provider.Meter(name, opts...)}
}

{{ ["MetricMeter returns the underlying metric.Meter, or a no-op one for the zero Meter."] | join | comment }}
func (m Meter) MetricMeter() metric.Meter {
	if m.meter == nil {
		return noop.Meter{}
	}
	return m.meter
}
{% endfilter %}
