{% include "header.j2" %}

declare const metricIdentity: unique symbol;
{% for metric in ctx.metrics %}

export declare const {{ metric.constant }}: {{ metric.wire_literal }};

{% if metric.attributes | length > 0 %}
export interface {{ metric.type_name }}Tags {
{% for attribute in metric.attributes %}
  readonly {{ attribute.key_literal }}{% if not attribute.required %}?{% endif %}: {{ attribute.ts_type }}{% if not attribute.required %} | undefined{% endif %};
{% endfor %}
}
{% else %}
export type {{ metric.type_name }}Tags = Record<string, never>;
{% endif %}

export interface {{ metric.type_name }} {
  readonly [metricIdentity]: "{{ metric.type_name }}";
  readonly {{ metric.method }}: (value: {% if metric.kind == "rate" %}number | boolean{% else %}number{% endif %}, tags{% if not metric.has_required %}?{% endif %}: {{ metric.type_name }}Tags) => boolean;
}

export declare function create{{ metric.type_name }}(): {{ metric.type_name }};
{% endfor %}

export {};
