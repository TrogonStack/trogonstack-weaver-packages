{% include "header.j2" %}

import { {{ ctx.imports | join(", ") }} } from "k6/metrics";

const metricIdentity = Symbol("metricIdentity");

interface TagDefinition {
  readonly key: string;
  readonly kind: "string" | "int" | "double" | "boolean";
  readonly required: boolean;
  readonly values?: readonly unknown[];
}

function validateValue(value: unknown, kind: string, integer: boolean, nonnegative: boolean): void {
  if (kind === "rate" && typeof value === "boolean") return;
  if (typeof value !== "number" || !Number.isFinite(value)) {
    throw new TypeError("Metric values must be finite numbers");
  }
  if (integer && !Number.isSafeInteger(value)) throw new TypeError("Metric value must be a safe integer");
  if (nonnegative && value < 0) throw new TypeError("Counter values must be nonnegative");
}

function encodeTags(input: unknown, definitions: readonly TagDefinition[]): Record<string, string> {
  if (input === null || typeof input !== "object" || Array.isArray(input) ||
      (Object.getPrototypeOf(input) !== Object.prototype && Object.getPrototypeOf(input) !== null)) {
    throw new TypeError("Tags must be a plain object");
  }
  for (const key of Reflect.ownKeys(input)) {
    if (!definitions.some((definition) => definition.key === key)) throw new TypeError("Unknown tag: " + String(key));
  }
  const tags: Record<string, string> = Object.create(null);
  for (const definition of definitions) {
    const descriptor = Object.getOwnPropertyDescriptor(input, definition.key);
    if (descriptor && !("value" in descriptor)) throw new TypeError("Tags must use data properties");
    const value: unknown = descriptor && descriptor.value;
    if (!descriptor || value === undefined) {
      if (definition.required) throw new TypeError("Missing required tag: " + definition.key);
      continue;
    }
    if (definition.kind === "int" || definition.kind === "double") {
      validateValue(value, "tag", definition.kind === "int", false);
    } else if (typeof value !== definition.kind) {
      throw new TypeError("Wrong value type for tag: " + definition.key);
    }
    if (definition.values && !definition.values.includes(value)) throw new TypeError("Unknown enum value for tag: " + definition.key);
    tags[definition.key] = String(value);
  }
  return tags;
}
{% for metric in ctx.metrics %}

export const {{ metric.constant }} = {{ metric.wire_literal }};

{% if metric.attributes | length > 0 %}
export interface {{ metric.type_name }}Tags {
{% for attribute in metric.attributes %}
  readonly {{ attribute.key_literal }}{% if not attribute.required %}?{% endif %}: {{ attribute.ts_type }}{% if not attribute.required %} | undefined{% endif %};
{% endfor %}
}
{% else %}
export type {{ metric.type_name }}Tags = Record<string, never>;
{% endif %}

export interface {{ metric.type_name }} {
  readonly [metricIdentity]: "{{ metric.type_name }}";
  readonly {{ metric.method }}: (value: {% if metric.kind == "rate" %}number | boolean{% else %}number{% endif %}, tags{% if not metric.has_required %}?{% endif %}: {{ metric.type_name }}Tags) => boolean;
}

export function create{{ metric.type_name }}(): {{ metric.type_name }} {
  const instrument = new {{ metric.constructor }}({{ metric.constant }}, {{ metric.is_time | tojson }});
  const definitions: readonly TagDefinition[] = {{ metric.tag_definitions }};
  return Object.freeze<{{ metric.type_name }}>({
    [metricIdentity]: "{{ metric.type_name }}",
    {{ metric.method }}(value, tags{% if not metric.has_required %} = {}{% endif %}) {
      validateValue(value, "{{ metric.kind }}", {{ (metric.value_type == "int") | tojson }}, {{ (metric.kind == "counter") | tojson }});
      // @types/k6 declares void, but k6 v2.3.0 returns bool:
      // https://github.com/grafana/k6/blob/v2.3.0/internal/js/modules/k6/metrics/metrics.go
      const recorded: unknown = instrument.add(value, encodeTags(tags, definitions));
      if (typeof recorded !== "boolean") throw new TypeError("Native metric recording must return a boolean");
      return recorded;
    },
  });
}
{%- endfor %}{{ "\n" }}
