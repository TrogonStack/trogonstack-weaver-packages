class InstrumentKind(enum.StrEnum):
    """Kind of an OpenTelemetry instrument."""

    COUNTER = "counter"
    UP_DOWN_COUNTER = "updowncounter"
    GAUGE = "gauge"
    HISTOGRAM = "histogram"


def get_meter(meter_provider: MeterProvider | None = None) -> Meter:
    """Return the meter that is tied to the schema URL of the registry."""
    return otel_metrics.get_meter(
        INSTRUMENTATION_NAME,
        INSTRUMENTATION_VERSION,
        meter_provider,
        schema_url=SCHEMA_URL,
    )
