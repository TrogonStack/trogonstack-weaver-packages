{% macro attribute_dict(metric) %}
{% if metric.required_attributes %}
        _attributes: dict[str, AttributeValue] = {
{% for attribute in metric.required_attributes %}
{% if attribute.is_array and attribute.dict_wrap %}
            {{ attribute.key_expression }}: [
                *{{ attribute.field }}
            ],
{% else %}
            {{ attribute.key_expression }}: {{ attribute.value_expression }},
{% endif %}
{% endfor %}
        }
{% else %}
        _attributes: dict[str, AttributeValue] = {}
{% endif %}
{% for attribute in metric.optional_attributes %}
        if {{ attribute.field }} is not None:
{% if attribute.assign_wrap and attribute.is_array %}
            _attributes[{{ attribute.key_expression }}] = [
                *{{ attribute.field }}
            ]
{% elif attribute.assign_wrap and attribute.is_enum %}
            _attributes[{{ attribute.key_expression }}] = (
                {{ attribute.value_expression }}
            )
{% else %}
            _attributes[{{ attribute.key_expression }}] = {{ attribute.value_expression }}
{% endif %}
{% endfor %}
{%- endmacro %}
{% macro argument_docs(metric, summary) %}
        """{{ summary }}

        Args:
{% for attribute in metric.attributes %}
{% if attribute.requirement_doc %}
            {{ attribute.field }}: {{ attribute.requirement_doc | indent(16) }}
{% endif %}
{% endfor %}
        """
{%- endmacro %}
