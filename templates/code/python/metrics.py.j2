{% macro parameters(metric, with_context=false) %}
        *,
{% for attribute in metric.required_attributes %}
        {{ attribute.field }}: {{ attribute.python_type }},
{% endfor %}
{% for attribute in metric.optional_attributes %}
        {{ attribute.field }}: {{ attribute.python_type }} | None = None,
