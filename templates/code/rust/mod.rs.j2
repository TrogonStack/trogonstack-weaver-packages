{% for member in attr.type.members %}
        {{ [member.brief, member.note] | select | join("\n\n") | comment | indent(8) }}
        {{ ("#[deprecated(note = " ~ member.deprecated_literal ~ ")]\n        ") if member.deprecated_literal else "" }}{{ member.name }},
{% endfor %}
    }
{% else %}
