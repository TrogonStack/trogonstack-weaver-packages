            Self(value{% if attr.value_type == "string" %}.into(){% endif %})
        }
{% endif %}

        pub fn key_value(self) -> ::opentelemetry::KeyValue {
{% if attr.type is mapping %}
            let value: {{ attr.value_type | map_text("rust_type") }} = match self {
{% for member in attr.type.members %}
                Self::{{ member.name }} => {{ member.literal }}{% if attr.value_type == "string" %}.into(){% elif attr.value_type == "double" %}_f64{% endif %},
{% endfor %}
            };
            ::opentelemetry::KeyValue::new(Self::KEY, value)
{% elif "[]" in attr.value_type %}
            ::opentelemetry::KeyValue::new(Self::KEY, ::opentelemetry::Value::Array(::opentelemetry::Array::{{ attr.value_type | map_text("rust_array") }}(self.0{% if attr.value_type == "string[]" %}.into_iter().map(Into::into).collect(){% endif %})))
{% else %}
            ::opentelemetry::KeyValue::new(Self::KEY, self.0)
{% endif %}
        }
    }

    #[allow(deprecated)]
    impl From<{{ attr.name }}> for ::opentelemetry::KeyValue {
        fn from(value: {{ attr.name }}) -> Self {
            value.key_value()
        }
    }
{% endfor %}
}
