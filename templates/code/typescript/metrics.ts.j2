{% import "macros.j2" as m %}
{% set synchronous = {"counter": "Counter", "updowncounter": "UpDownCounter", "histogram": "Histogram", "gauge": "Gauge"} %}
{{ m.header() }}
import * as api from "@opentelemetry/api";
{% if ctx.uses_attribute_types %}
import type * as attributes from "./attributes.ts";
{% endif %}
import { SCHEMA_URL } from "./schema.ts";

export const INSTRUMENTATION_NAME = {{ params.instrumentation_name | tojson }};
{% if params.instrumentation_version %}
export const INSTRUMENTATION_VERSION = {{ params.instrumentation_version | tojson }};
{% endif %}

let apiMeter: (meter: Meter) => api.Meter;

/**
 * Creates the generated instruments with the instrumentation scope and schema
 * URL of the registry. Without a provider, it uses the global meter provider.
 */
export class Meter {
  readonly #meter: api.Meter;

  static {
    apiMeter = (meter) => meter.#meter;
  }

  constructor(meterProvider: api.MeterProvider = api.metrics.getMeterProvider()) {
    this.#meter = meterProvider.getMeter(INSTRUMENTATION_NAME, {{ "INSTRUMENTATION_VERSION" if params.instrumentation_version else "undefined" }}, { schemaUrl: SCHEMA_URL });
  }
}
{% for metric in ctx.metrics %}
{% set type = metric.type_name %}
{% set kind = synchronous[metric.instrument] %}
{% set method = "add" if metric.instrument in ["counter", "updowncounter"] else "record" %}
{% set has_attributes = metric.attributes | length > 0 %}
{% set optional_only = has_attributes and not metric.has_required %}
{% set parameters = ", attributes: " ~ type ~ "Attributes" ~ (" = {}" if optional_only else "") if has_attributes else "" %}
{% set arguments = ", to" ~ type ~ "Attributes(attributes)" if has_attributes else "" %}
{% if has_attributes %}

export type {{ type }}Attributes = {
{% for attribute in metric.attributes %}
  {{ m.doc(attribute.brief, attribute.note, attribute.requirement_doc, attribute.deprecation, 2) }}readonly {{ attribute.field }}{{ "?" if attribute.optional }}: {{ attribute.ts_type }}{{ " | undefined" if attribute.optional }};
{% endfor %}
};

function to{{ type }}Attributes(attributes: {{ type }}Attributes): api.Attributes {
{% set optionals = metric.attributes | selectattr("optional") | list %}
{% if optionals | length > 0 %}
{% set required = metric.attributes | rejectattr("optional") | list %}
{% if required | length > 0 %}
  const result: api.Attributes = {
{% for attribute in required %}
    {{ attribute.key | tojson }}: {{ m.attribute_value(attribute) }},
{% endfor %}
  };
{% else %}
  const result: api.Attributes = {};
{% endif %}
{% for attribute in optionals %}
  if (attributes.{{ attribute.field }} !== undefined) {
    result[{{ attribute.key | tojson }}] = {{ m.attribute_value(attribute) }};
  }
{% endfor %}
  return result;
{% else %}
  return {
{% for attribute in metric.attributes %}
    {{ attribute.key | tojson }}: {{ m.attribute_value(attribute) }},
{% endfor %}
  };
{% endif %}
}
{% endif %}

{{ m.doc(metric.brief, metric.note, "Opt-in: record it only when the user asks for it." if metric.requirement_level == "opt_in" else none, metric.deprecation, 0) }}export class {{ type }} {
  static readonly NAME = {{ metric.instrument_name | tojson }};

  readonly #instrument: api.{{ kind }};

  constructor(meter: Meter) {
    this.#instrument = apiMeter(meter).create{{ kind }}({{ type }}.NAME, {
      description: {{ (metric.description or "") | trim | tojson }},
      unit: {{ metric.unit | tojson }},
{% if metric.value_type %}
      valueType: api.ValueType.{{ metric.value_type | upper }},
{% endif %}
{% if metric.bucket_boundaries %}
      advice: { explicitBucketBoundaries: [{% for boundary in metric.bucket_boundaries %}{{ boundary | tojson }}{{ ", " if not loop.last }}{% endfor %}] },
{% endif %}
    });
  }

  {{ method }}(value: number{{ parameters }}): void {
    this.#instrument.{{ method }}(value{{ arguments }});
  }
}
{% if metric.instrument != "histogram" %}

export type {{ type }}Observer = {
  observe(value: number{{ ", attributes" ~ ("?" if optional_only) ~ ": " ~ type ~ "Attributes" if has_attributes }}): void;
};

export type {{ type }}Callback = (observer: {{ type }}Observer) => void | Promise<void>;

{{ m.doc("Observes " ~ metric.instrument_name ~ " when the SDK collects.", none, none, metric.deprecation, 0) }}export class {{ type }}Observable {
  static readonly NAME = {{ type }}.NAME;

  readonly #instrument: api.Observable{{ kind }};
  readonly #callback: api.ObservableCallback;

  constructor(meter: Meter, callback: {{ type }}Callback) {
    this.#instrument = apiMeter(meter).createObservable{{ kind }}({{ type }}Observable.NAME, {
      description: {{ (metric.description or "") | trim | tojson }},
      unit: {{ metric.unit | tojson }},
{% if metric.value_type %}
      valueType: api.ValueType.{{ metric.value_type | upper }},
{% endif %}
    });
    this.#callback = (result) =>
      callback({
        observe: (value{{ ", attributes" if has_attributes }}) => {
          result.observe(value{{ ", to" ~ type ~ "Attributes(attributes" ~ (" ?? {}" if optional_only) ~ ")" if has_attributes }});
        },
      });
    this.#instrument.addCallback(this.#callback);
  }

  stop(): void {
    this.#instrument.removeCallback(this.#callback);
  }
}
{% endif %}
{% endfor %}
